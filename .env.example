# BL Transition Pipeline — API Keys
# Copy this file to .env and fill in your own values. Never commit .env.

ANTHROPIC_API_KEY=

OPENAI_API_KEY=
XAI_API_KEY=


TAVILY_API_KEY=

# Optional: email for polite API access (paper download)
CONTACT_EMAIL=

# Budget limit per run (USD)
BUDGET_LIMIT_USD=10.0

# Pin to Nemotron so re-ingest never silently falls back to OpenAI when
# env vars aren't explicitly set.
BL_RAG_VERSION=v2_nemotron_8b
# Note: HuggingFace repo uses HYPHEN, not colon.  HF cache dir is
# models--nvidia--llama-embed-nemotron-8b — that's the canonical name.
BL_EMBEDDING_MODEL=nvidia/llama-embed-nemotron-8b

BL_EMBED_SERVER=http://127.0.0.1:8765
